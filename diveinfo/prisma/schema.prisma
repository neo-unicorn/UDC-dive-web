// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 文章表
model Article {
  id              String    @id @default(cuid())
  slug            String    @unique
  locale          String    @default("zh") // zh | en
  
  // 内容
  title           String
  excerpt         String?
  content         String
  coverImage      String?   @map("cover_image")
  
  // SEO 元数据
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")
  
  // 状态
  published       Boolean   @default(false)
  publishedAt     DateTime? @map("published_at")
  
  // 分类关联
  categoryId      String?   @map("category_id")
  category        Category? @relation(fields: [categoryId], references: [id])
  
  // 标签关联
  tags            TagsOnArticles[]
  
  // 双语关联
  linkedArticleId String?   @unique @map("linked_article_id")
  linkedArticle   Article?  @relation("ArticleLink", fields: [linkedArticleId], references: [id])
  linkedBy        Article?  @relation("ArticleLink")
  
  // 元数据
  viewCount       Int       @default(0) @map("view_count")
  wordCount       Int       @default(0) @map("word_count")
  readingTime     Int       @default(0) @map("reading_time") // 阅读时间（分钟）
  sourceWorkflow  String?   @map("source_workflow")
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([locale, published])
  @@index([categoryId])
  @@index([publishedAt])
  @@index([slug, locale]) // 复合索引：优化双语查询
  @@map("articles")
}

/// 分类表
model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameZh    String    @map("name_zh")
  nameEn    String    @map("name_en")
  articles  Article[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("categories")
}

/// 标签表
model Tag {
  id        String           @id @default(cuid())
  slug      String           @unique
  nameZh    String           @map("name_zh")
  nameEn    String           @map("name_en")
  articles  TagsOnArticles[]
  createdAt DateTime         @default(now()) @map("created_at")

  @@map("tags")
}

/// 文章-标签关联表（多对多）
model TagsOnArticles {
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String  @map("article_id")
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String  @map("tag_id")

  @@id([articleId, tagId])
  @@map("tags_on_articles")
}

/// API Key 表（用于文章提交认证）
model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("api_keys")
}
