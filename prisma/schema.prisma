generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id              String    @id @default(cuid())
  slug            String    @unique
  locale          String    @default("zh")
  title           String
  excerpt         String?
  content         String
  coverImage      String?   @map("cover_image")
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")
  published       Boolean   @default(false)
  publishedAt     DateTime? @map("published_at")
  categoryId      String?   @map("category_id")
  category        Category? @relation(fields: [categoryId], references: [id])
  tags            TagsOnArticles[]
  linkedArticleId String?   @unique @map("linked_article_id")
  linkedArticle   Article?  @relation("ArticleLink", fields: [linkedArticleId], references: [id])
  linkedBy        Article?  @relation("ArticleLink")
  viewCount       Int       @default(0) @map("view_count")
  wordCount       Int       @default(0) @map("word_count")
  readingTime     Int       @default(0) @map("reading_time")
  sourceWorkflow  String?   @map("source_workflow")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([locale, published])
  @@index([categoryId])
  @@index([publishedAt])
  @@map("articles")
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameZh    String    @map("name_zh")
  nameEn    String    @map("name_en")
  articles  Article[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("categories")
}

model Tag {
  id        String           @id @default(cuid())
  slug      String           @unique
  nameZh    String           @map("name_zh")
  nameEn    String           @map("name_en")
  articles  TagsOnArticles[]
  createdAt DateTime         @default(now()) @map("created_at")

  @@map("tags")
}

model TagsOnArticles {
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String  @map("article_id")
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId     String  @map("tag_id")

  @@id([articleId, tagId])
  @@map("tags_on_articles")
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("api_keys")
}
