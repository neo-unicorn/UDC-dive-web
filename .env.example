# ===========================================
# DiveInfo 环境变量配置示例
# 复制此文件为 .env.local 并填入实际值
# ===========================================

# 数据库连接 (Vercel Postgres / Neon / Supabase)
DATABASE_URL="postgresql://username:password@host:5432/diveinfo?sslmode=require"

# Vercel Blob 存储（用于图片上传）
BLOB_READ_WRITE_TOKEN=""

# API 认证密钥（用于 Neo 工作流调用）
API_KEY="your-secret-api-key-here"

# 应用配置
NEXT_PUBLIC_BASE_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_DEFAULT_LOCALE="zh"

# 可选：Vercel Analytics
# VERCEL_ANALYTICS_ID=""

# ===== OpenClaw Gateway 推送配置（可选）=====
# OpenClaw Gateway 地址（默认端口 18789）
# OPENCLAW_GATEWAY_URL="http://your-openclaw-ip:18789"

# OpenClaw Hook Token（在 ~/.openclaw/config.json 中配置的随机密钥）
# OPENCLAW_HOOK_TOKEN="your-64-char-random-token"

# 推送渠道（telegram / feishu / discord 等）
# OPENCLAW_CHANNEL="telegram"

# 推送目标 ID（Telegram chat_id、飞书群 ID 等）
# OPENCLAW_TO="your-chat-id-or-group-id"
